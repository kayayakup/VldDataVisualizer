<Window x:Class="VldDataVisualizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VldDataVisualizer.ViewModels"
        Title="VLD-TFPR Data Visualizer - 36kV Sistem" Height="900" Width="1400"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="StatusIndicator" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style x:Key="AlarmIndicator" TargetType="Border">
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Background" Value="#ffebee"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2c3e50" CornerRadius="5" Padding="15">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="VLD-TFPR 36kV Sistem Simülasyon ve İzleme" 
                          Foreground="White" FontSize="18" FontWeight="Bold"/>

                <Button x:Name="StartButton" Content="Simülasyonu Başlat" 
                        Click="StartButton_Click" Margin="20,0,10,0" Padding="10,5"/>
                <Button x:Name="StopButton" Content="Simülasyonu Durdur" 
                        Click="StopButton_Click" Padding="10,5" IsEnabled="False"/>

                <Button x:Name="VoltageSagButton" Content="Gerilim Düşüşü Senaryosu" 
                        Click="VoltageSagButton_Click" Margin="10,0,5,0" Padding="8,5" Background="#ff9800"/>
                <Button x:Name="OverloadButton" Content="Aşırı Yük Senaryosu" 
                        Click="OverloadButton_Click" Margin="5,0,5,0" Padding="8,5" Background="#f44336"/>
                <Button x:Name="ResetButton" Content="Normal Mod" 
                        Click="ResetButton_Click" Margin="5,0,20,0" Padding="8,5" Background="#4caf50"/>

                <TextBlock x:Name="StatusText" Text=" Durum: Hazır" 
                          Foreground="LightGreen" FontSize="12" 
                          VerticalAlignment="Center" Margin="20,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
            <StackPanel>

                <!-- System Overview -->
                <GroupBox Header="Sistem Genel Bakış" Margin="0,0,0,10">
                    <WrapPanel Orientation="Horizontal">
                        <Border Style="{StaticResource StatusIndicator}" Background="#e8f5e8">
                            <TextBlock x:Name="DeviceIdText" Text="Cihaz: VLD-TFPR_001" FontWeight="Bold"/>
                        </Border>
                        <Border Style="{StaticResource StatusIndicator}" Background="#e3f2fd">
                            <TextBlock x:Name="LocationText" Text="Lokasyon: TRAFO MERKEZİ" FontWeight="Bold"/>
                        </Border>
                        <Border x:Name="CommunicationStatusBorder" Style="{StaticResource StatusIndicator}" Background="#4caf50">
                            <TextBlock x:Name="CommunicationText" Text="İletişim: AKTİF" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </WrapPanel>
                </GroupBox>

                <!-- Real-time Power Values -->
                <GroupBox Header="Anlık Güç Değerleri" Margin="0,0,0,10">
                    <WrapPanel Orientation="Horizontal">
                        <Border Style="{StaticResource StatusIndicator}" Background="#e8f5e8">
                            <TextBlock x:Name="VoltageInText" Text="Giriş Gerilimi: -- kV" FontWeight="Bold"/>
                        </Border>
                        <Border Style="{StaticResource StatusIndicator}" Background="#e8f5e8">
                            <TextBlock x:Name="VoltageOutText" Text="Çıkış Gerilimi: -- kV" FontWeight="Bold"/>
                        </Border>
                        <Border Style="{StaticResource StatusIndicator}" Background="#e3f2fd">
                            <TextBlock x:Name="CurrentText" Text="Toplam Akım: -- A" FontWeight="Bold"/>
                        </Border>
                        <Border Style="{StaticResource StatusIndicator}" Background="#fff3e0">
                            <TextBlock x:Name="ActivePowerText" Text="Aktif Güç: -- kW" FontWeight="Bold"/>
                        </Border>
                        <Border Style="{StaticResource StatusIndicator}" Background="#fff3e0">
                            <TextBlock x:Name="ReactivePowerText" Text="Reaktif Güç: -- kVAr" FontWeight="Bold"/>
                        </Border>
                        <Border Style="{StaticResource StatusIndicator}" Background="#e3f2fd">
                            <TextBlock x:Name="PowerFactorText" Text="Güç Faktörü: --" FontWeight="Bold"/>
                        </Border>
                    </WrapPanel>
                </GroupBox>

                <!-- Phase Values -->
                <GroupBox Header="Faz Değerleri" Margin="0,0,0,10">
                    <WrapPanel Orientation="Horizontal">
                        <Border Style="{StaticResource StatusIndicator}" Background="#f3e5f5">
                            <TextBlock x:Name="VoltageL1Text" Text="L1 Gerilimi: -- kV" FontWeight="Bold"/>
                        </Border>
                        <Border Style="{StaticResource StatusIndicator}" Background="#f3e5f5">
                            <TextBlock x:Name="VoltageL2Text" Text="L2 Gerilimi: -- kV" FontWeight="Bold"/>
                        </Border>
                        <Border Style="{StaticResource StatusIndicator}" Background="#f3e5f5">
                            <TextBlock x:Name="VoltageL3Text" Text="L3 Gerilimi: -- kV" FontWeight="Bold"/>
                        </Border>
                        <Border Style="{StaticResource StatusIndicator}" Background="#e8f5e8">
                            <TextBlock x:Name="CurrentL1Text" Text="L1 Akımı: -- A" FontWeight="Bold"/>
                        </Border>
                        <Border Style="{StaticResource StatusIndicator}" Background="#e8f5e8">
                            <TextBlock x:Name="CurrentL2Text" Text="L2 Akımı: -- A" FontWeight="Bold"/>
                        </Border>
                        <Border Style="{StaticResource StatusIndicator}" Background="#e8f5e8">
                            <TextBlock x:Name="CurrentL3Text" Text="L3 Akımı: -- A" FontWeight="Bold"/>
                        </Border>
                    </WrapPanel>
                </GroupBox>

                <!-- System Parameters -->
                <GroupBox Header="Sistem Parametreleri" Margin="0,0,0,10">
                    <WrapPanel Orientation="Horizontal">
                        <Border Style="{StaticResource StatusIndicator}" Background="#ffebee">
                            <TextBlock x:Name="TemperatureText" Text="Sıcaklık: -- °C" FontWeight="Bold"/>
                        </Border>
                        <Border Style="{StaticResource StatusIndicator}" Background="#e3f2fd">
                            <TextBlock x:Name="FrequencyText" Text="Frekans: -- Hz" FontWeight="Bold"/>
                        </Border>
                        <Border Style="{StaticResource StatusIndicator}" Background="#fff3e0">
                            <TextBlock x:Name="GroundCurrentText" Text="Toprak Akımı: -- A" FontWeight="Bold"/>
                        </Border>
                        <Border Style="{StaticResource StatusIndicator}" Background="#f3e5f5">
                            <TextBlock x:Name="THDVoltageText" Text="Gerilim THD: -- %" FontWeight="Bold"/>
                        </Border>
                        <Border Style="{StaticResource StatusIndicator}" Background="#f3e5f5">
                            <TextBlock x:Name="THDCurrentText" Text="Akım THD: -- %" FontWeight="Bold"/>
                        </Border>
                    </WrapPanel>
                </GroupBox>

                <!-- Alarms -->
                <GroupBox Header="Aktif Alarmlar" Margin="0,0,0,10">
                    <ItemsControl x:Name="AlarmsItemsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource AlarmIndicator}">
                                    <TextBlock Text="{Binding}" FontWeight="Bold" Foreground="#d32f2f"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </GroupBox>

                <!-- Status -->
                <GroupBox Header="Sistem Durumu" Margin="0,0,0,10">
                    <WrapPanel Orientation="Horizontal">
                        <Border x:Name="StatusBorder" Style="{StaticResource StatusIndicator}" Background="#e8f5e8">
                            <TextBlock x:Name="StatusValueText" Text="Durum: NORMAL" FontWeight="Bold"/>
                        </Border>
                        <Border Style="{StaticResource StatusIndicator}" Background="#e8f5e8">
                            <TextBlock x:Name="EnergyImportText" Text="Tüketilen Enerji: -- kWh" FontWeight="Bold"/>
                        </Border>
                    </WrapPanel>
                </GroupBox>

                <!-- Charts -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="300"/>
                        <RowDefinition Height="300"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Voltage vs Time Chart -->
                    <GroupBox Grid.Row="0" Grid.Column="0" Header="Zaman - Gerilim Grafiği" Margin="0,0,5,5">
                        <local:SimpleChart x:Name="VoltageChart" 
                          Title="Çıkış Gerilimi (kV)" 
                          YAxisTitle="kV"
                          MinY="20" 
                          MaxY="40"
                          AutoScaleY="True"
                          LineColor="Blue"
                          BackgroundColor="White"/>
                    </GroupBox>

                    <!-- Current vs Time Chart -->
                    <GroupBox Grid.Row="0" Grid.Column="1" Header="Zaman - Akım Grafiği" Margin="5,0,0,5">
                        <local:SimpleChart x:Name="CurrentChart" 
                          Title="Toplam Akım (A)" 
                          YAxisTitle="A"
                          MinY="0" 
                          MaxY="800"
                          AutoScaleY="True"
                          LineColor="Red"
                          BackgroundColor="White"/>
                    </GroupBox>

                    <!-- Power vs Time Chart -->
                    <GroupBox Grid.Row="1" Grid.Column="0" Header="Zaman - Güç Grafiği" Margin="0,5,5,0">
                        <local:SimpleChart x:Name="PowerChart" 
                          Title="Aktif Güç (kW)" 
                          YAxisTitle="kW"
                          MinY="0" 
                          MaxY="25000"
                          AutoScaleY="True"
                          LineColor="Green"
                          BackgroundColor="White"/>
                    </GroupBox>

                    <!-- Temperature vs Time Chart -->
                    <GroupBox Grid.Row="1" Grid.Column="1" Header="Zaman - Sıcaklık Grafiği" Margin="5,5,0,0">
                        <local:SimpleChart x:Name="TemperatureChart" 
                          Title="Sıcaklık (°C)" 
                          YAxisTitle="°C"
                          MinY="20" 
                          MaxY="100"
                          AutoScaleY="True"
                          LineColor="Orange"
                          BackgroundColor="White"/>
                    </GroupBox>
                </Grid>

                <!-- Data Table -->
                <GroupBox Header="Son Ölçüm Verileri" Margin="0,10,0,0">
                    <DataGrid x:Name="DataGrid" AutoGenerateColumns="False" Height="250">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Zaman" Binding="{Binding Timestamp, StringFormat=HH:mm:ss}"/>
                            <DataGridTextColumn Header="Gerilim Giriş (kV)" Binding="{Binding VoltageIn, StringFormat=N1}"/>
                            <DataGridTextColumn Header="Gerilim Çıkış (kV)" Binding="{Binding VoltageOut, StringFormat=N1}"/>
                            <DataGridTextColumn Header="Akım (A)" Binding="{Binding Current, StringFormat=N0}"/>
                            <DataGridTextColumn Header="Aktif Güç (kW)" Binding="{Binding ActivePower, StringFormat=N0}"/>
                            <DataGridTextColumn Header="Sıcaklık (°C)" Binding="{Binding Temperature, StringFormat=N1}"/>
                            <DataGridTextColumn Header="Frekans (Hz)" Binding="{Binding Frequency, StringFormat=N2}"/>
                            <DataGridTextColumn Header="Durum" Binding="{Binding Status}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2">
            <StatusBarItem Content="VLD-TFPR 36kV Sistem İzleme"/>
            <Separator/>
            <StatusBarItem x:Name="DataCountText" Content="Veri Sayısı: 0"/>
            <Separator/>
            <StatusBarItem x:Name="LastUpdateText" Content="Son Güncelleme: --"/>
            <Separator/>
            <StatusBarItem Content="Hazır"/>
        </StatusBar>

    </Grid>
</Window>