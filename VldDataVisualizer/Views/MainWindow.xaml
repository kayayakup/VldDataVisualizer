<Window x:Class="VldDataVisualizer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VldDataVisualizer.ViewModels"
        xmlns:converters="clr-namespace:VldDataVisualizer.Converters"
        mc:Ignorable="d"
        Title="VLD-TFPR - 12 İstasyon İzleme - Gebze Darıca Metro"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <converters:StringToBrushConverter x:Key="StringToBrushConverter"/>
        <converters:TrackTypeToColorConverter x:Key="TrackTypeToColorConverter"/>
        <converters:SpeedToColorConverter x:Key="SpeedToColorConverter"/>
        <Style x:Key="StatusIndicator" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style x:Key="AlarmIndicator" TargetType="Border">
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Background" Value="#ffebee"/>
        </Style>

        <Style x:Key="EmergencyButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#d32f2f"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="#b71c1c"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="3"/>
        </Style>

        <Style x:Key="MiniChartGroupBox" TargetType="GroupBox">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="BorderBrush" Value="#2196f3"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Width" Value="280"/>
            <Setter Property="Height" Value="220"/>
        </Style>

        <DropShadowEffect x:Key="PopupDropShadow" 
                          Color="#000000" 
                          BlurRadius="24" 
                          ShadowDepth="6" 
                          Opacity="0.6"
                          Direction="270"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="MainContentColumn" Width="*" />
            <!-- 0: Ana içerik -->
            <ColumnDefinition Width="5" MinWidth="5" MaxWidth="5" />
            <!-- 1: Splitter -->
            <ColumnDefinition x:Name="RightPanelColumn" Width="0" MinWidth="0" MaxWidth="1000"/>
            <!-- 2: Sağ panel (başlangıçta 0) -->
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#2c3e50" CornerRadius="5" >
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="100"/>
                        <ColumnDefinition Width="*" MinWidth="200"/>
                        <ColumnDefinition Width="Auto" MinWidth="100"/>
                        <ColumnDefinition Width="Auto" MinWidth="150"/>
                    </Grid.ColumnDefinitions>

                    <!-- Başlık -->
                    <TextBlock Grid.Column="0" 
               Text="Kaçak Akım İzleme - Gebze Darıca Metro" 
               Margin="0,0,15,0"
               Foreground="White" 
               FontSize="16" 
               FontWeight="Bold" 
               VerticalAlignment="Center"
               TextWrapping="Wrap"
               TextTrimming="CharacterEllipsis"/>

                    <!-- Kontrol Butonları -->
                    <StackPanel Grid.Column="1" 
                Orientation="Horizontal" 
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                        <CheckBox x:Name="RealDataModeCheckBox"
                Content="🔌 Gerçek Veri (Modbus)" 
                Foreground="White"
                VerticalAlignment="Center"
                Margin="10,0,15,0"
                FontWeight="Bold"/>

                        <Button x:Name="StartAllButton" 
                Content="▶ Tümünü Başlat" 
                Click="StartAllButton_Click" 
                Background="#4caf50" 
                Padding="15,8" 
                FontWeight="SemiBold"
                MinWidth="120"
                Margin="0,0,5,0"/>

                        <Button x:Name="StopAllButton" 
                Content="⏹ Tümünü Durdur" 
                Click="StopAllButton_Click" 
                Background="#f44336" 
                Padding="15,8" 
                Margin="5,0" 
                FontWeight="SemiBold" 
                IsEnabled="False"
                MinWidth="120"/>

                        <Button x:Name="EmergencyButton" 
                Content="🚨 ACİL DUR" 
                Click="EmergencyButton_Click" 
                Style="{StaticResource EmergencyButtonStyle}"
                Margin="10,0,0,0"
                MinWidth="100"/>
                    </StackPanel>

                    <!-- Durum Göstergesi -->
                    <Border Grid.Column="2" 
            Background="#34495e" 
            CornerRadius="15" 
            Padding="10,5"
            Margin="5,0"
            VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderStatusText" 
                   Text="🟢 12 Cihaz Hazır" 
                   Foreground="White" 
                   FontSize="11" 
                   FontWeight="Bold"
                   TextAlignment="Center"/>
                    </Border>

                    <!-- Log Butonları -->
                    <StackPanel Grid.Column="3" 
                Orientation="Horizontal" 
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="5,0,0,0">
                        <Button Content="📂 Log Dosyasını Aç"
                Padding="10,5"
                Click="OpenLogFile_Click"
                MinWidth="120"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Ana İçerik - 3 Sekme -->
            <TabControl Grid.Row="1" Margin="0,10,0,0">

                <!-- SEKME 1: Hat Görünümü ve 12 VLD-TFPR Grafikleri -->
                <TabItem Header="🚆 Hat Görünümü - TFPR Akım">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Tren Hatları Görseli -->
                        <GroupBox Grid.Row="0" Header="Gebze-Darıca Metro Hattı - Gerçek Zamanlı Tren Konumları" Margin="5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" ClipToBounds="True" Background="White"
                                        MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                                        MouseLeftButtonUp="Canvas_MouseLeftButtonUp"
                                        MouseMove="Canvas_MouseMove"
                                        MouseWheel="Canvas_MouseWheel">
                                    <Canvas x:Name="RailwayCanvas" Height="500" Width="2400" 
                                            Margin="0,0,0,0" Background="Transparent">
                                        <Canvas.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform x:Name="CanvasScaleTransform" ScaleX="1" ScaleY="1"/>
                                                <TranslateTransform x:Name="CanvasTranslateTransform" X="0" Y="0"/>
                                            </TransformGroup>
                                        </Canvas.RenderTransform>
                                    </Canvas>
                                </Border>

                                <!-- Kaçak Bilgi Popup'ı -->
                                <Popup x:Name="LeakInfoPopup" 
                                       Grid.Row="0"
                                       AllowsTransparency="True" 
                                       PopupAnimation="Fade"
                                       Placement="Mouse"
                                       HorizontalOffset="12"
                                       VerticalOffset="12"
                                       StaysOpen="False"
                                       IsHitTestVisible="False">
                                    <Border x:Name="LeakPopupBorder"
                                            Background="#F0161625"
                                            BorderThickness="1.5"
                                            BorderBrush="#FF42A5F5"
                                            CornerRadius="8"
                                            Padding="0"
                                            MaxWidth="520"
                                            MinWidth="340"
                                            Effect="{StaticResource PopupDropShadow}">
                                        <StackPanel x:Name="LeakPopupContent" />
                                    </Border>
                                </Popup>

                                <Border Grid.Row="1" Background="#f8f9fa" BorderBrush="#ddd" BorderThickness="0,1,0,0" Padding="5">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📏 Hat Uzunluğu: 15,391.246 m" FontWeight="SemiBold" Margin="0,0,15,0"/>
                                        <TextBlock Text="🎯 Ölçek: 1:1000" FontWeight="SemiBold" Margin="0,0,15,0"/>
                                        <TextBlock x:Name="CanvasInfoText" Text="Aktif Trenler: 0" FontSize="10" Foreground="#666"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </GroupBox>

                        <!-- 12 VLD-TFPR Ute Grafikleri -->
                        <GroupBox Grid.Row="1" Header="12 İstasyon Ute Grafikleri" Margin="5" Height="280">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal">

                                    <!-- İstasyon 1 - Depo -->
                                    <GroupBox Style="{StaticResource MiniChartGroupBox}">
                                        <GroupBox.Header>
                                            <TextBlock x:Name="Station1Header" Text="🚉 Depo" FontWeight="Bold" Foreground="#1976d2"/>
                                        </GroupBox.Header>
                                        <local:ChartsProperties x:Name="Chart1" 
                    Title="Ute" YAxisTitle="V/A" XAxisTitle="Zaman"  LineColor="Red" BackgroundColor="White" MinY="0" MaxY="1000"/>
                                    </GroupBox>

                                    <!-- VLD Pano Durum Bilgisi (Depo grafiğinin yanında) -->
                                    <GroupBox Style="{StaticResource MiniChartGroupBox}" BorderBrush="#4caf50">
                                        <GroupBox.Header>
                                            <TextBlock Text="📋 VLD Pano Durum" FontWeight="Bold" Foreground="#2e7d32"/>
                                        </GroupBox.Header>
                                        <TextBox x:Name="OutputBox"
                                                 FontFamily="Consolas"
                                                 FontSize="9"
                                                 IsReadOnly="True"
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Disabled"
                                                 Background="#f5f5f5"
                                                 BorderThickness="0"
                                                 TextWrapping="Wrap"
                                                 Text="Veri bekleniyor..."/>
                                    </GroupBox>

                                    <!-- İstasyon 2 - OSB -->
                                    <GroupBox Style="{StaticResource MiniChartGroupBox}">
                                        <GroupBox.Header>
                                            <TextBlock x:Name="Station2Header" Text="🚉 OSB" FontWeight="Bold" Foreground="#1976d2"/>
                                        </GroupBox.Header>
                                        <local:ChartsProperties x:Name="Chart2" 
                        Title="Ute" YAxisTitle="V/A" XAxisTitle="Zaman"
                         LineColor="Red" BackgroundColor="White" MinY="0" MaxY="1000"/>
                                    </GroupBox>

                                    <!-- İstasyon 3 - Mutlukent -->
                                    <GroupBox Style="{StaticResource MiniChartGroupBox}">
                                        <GroupBox.Header>
                                            <TextBlock x:Name="Station3Header" Text="🚉 Mutlukent" FontWeight="Bold" Foreground="#1976d2"/>
                                        </GroupBox.Header>
                                        <local:ChartsProperties x:Name="Chart3" 
                    Title="Ute" YAxisTitle="V/A" XAxisTitle="Zaman"
                     LineColor="Red" BackgroundColor="White" MinY="0" MaxY="1000"/>
                                    </GroupBox>

                                    <!-- İstasyon 4 - Adliye -->
                                    <GroupBox Style="{StaticResource MiniChartGroupBox}">
                                        <GroupBox.Header>
                                            <TextBlock x:Name="Station4Header" Text="🚉 Adliye" FontWeight="Bold" Foreground="#1976d2"/>
                                        </GroupBox.Header>
                                        <local:ChartsProperties x:Name="Chart4" 
                    Title="Ute" YAxisTitle="V/A" XAxisTitle="Zaman"
                     LineColor="Red" BackgroundColor="White" MinY="0" MaxY="1000"/>
                                    </GroupBox>

                                    <!-- İstasyon 5 - Akse Sapağı -->
                                    <GroupBox Style="{StaticResource MiniChartGroupBox}">
                                        <GroupBox.Header>
                                            <TextBlock x:Name="Station5Header" Text="🚉 Akse Sapağı" FontWeight="Bold" Foreground="#1976d2"/>
                                        </GroupBox.Header>
                                        <local:ChartsProperties x:Name="Chart5" 
                    Title="Ute" YAxisTitle="V/A" XAxisTitle="Zaman"
                     LineColor="Red" BackgroundColor="White" MinY="0" MaxY="1000"/>
                                    </GroupBox>

                                    <!-- İstasyon 6 - Gebze Stadyum -->
                                    <GroupBox Style="{StaticResource MiniChartGroupBox}">
                                        <GroupBox.Header>
                                            <TextBlock x:Name="Station6Header" Text="🚉 Gebze Stadyum" FontWeight="Bold" Foreground="#1976d2"/>
                                        </GroupBox.Header>
                                        <local:ChartsProperties x:Name="Chart6" 
                    Title="Ute" YAxisTitle="V/A" XAxisTitle="Zaman"
                     LineColor="Red" BackgroundColor="White" MinY="0" MaxY="1000"/>
                                    </GroupBox>

                                    <!-- İstasyon 7 - Gebze Kent Meydanı -->
                                    <GroupBox Style="{StaticResource MiniChartGroupBox}">
                                        <GroupBox.Header>
                                            <TextBlock x:Name="Station7Header" Text="🚉 Gebze Kent Meydanı" FontWeight="Bold" Foreground="#1976d2"/>
                                        </GroupBox.Header>
                                        <local:ChartsProperties x:Name="Chart7" 
                    Title="Ute" YAxisTitle="V/A" XAxisTitle="Zaman"
                     LineColor="Red" BackgroundColor="White" MinY="0" MaxY="1000"/>
                                    </GroupBox>

                                    <!-- İstasyon 8 - Fatih D. Hastanesi -->
                                    <GroupBox Style="{StaticResource MiniChartGroupBox}">
                                        <GroupBox.Header>
                                            <TextBlock x:Name="Station8Header" Text="🚉 Fatih D. Hastanesi" FontWeight="Bold" Foreground="#1976d2"/>
                                        </GroupBox.Header>
                                        <local:ChartsProperties x:Name="Chart8" 
                    Title="Ute" YAxisTitle="V/A" XAxisTitle="Zaman"
                     LineColor="Red" BackgroundColor="White" MinY="0" MaxY="1000"/>
                                    </GroupBox>

                                    <!-- İstasyon 9 - TCDD Gar -->
                                    <GroupBox Style="{StaticResource MiniChartGroupBox}">
                                        <GroupBox.Header>
                                            <TextBlock x:Name="Station9Header" Text="🚉 TCDD Gar" FontWeight="Bold" Foreground="#1976d2"/>
                                        </GroupBox.Header>
                                        <local:ChartsProperties x:Name="Chart9" 
                    Title="Ute" YAxisTitle="V/A" XAxisTitle="Zaman"
                     LineColor="Red" BackgroundColor="White" MinY="0" MaxY="1000"/>
                                    </GroupBox>

                                    <!-- İstasyon 10 - Farabi D. Hastanesi -->
                                    <GroupBox Style="{StaticResource MiniChartGroupBox}">
                                        <GroupBox.Header>
                                            <TextBlock x:Name="Station10Header" Text="🚉 Farabi D. Hastanesi" FontWeight="Bold" Foreground="#1976d2"/>
                                        </GroupBox.Header>
                                        <local:ChartsProperties x:Name="Chart10" 
                    Title="Ute" YAxisTitle="V/A" XAxisTitle="Zaman"
                     LineColor="Red" BackgroundColor="White" MinY="0" MaxY="1000"/>
                                    </GroupBox>

                                    <!-- İstasyon 11 - Darıca Cumhuriyet -->
                                    <GroupBox Style="{StaticResource MiniChartGroupBox}">
                                        <GroupBox.Header>
                                            <TextBlock x:Name="Station11Header" Text="🚉 Darıca Cumhuriyet" FontWeight="Bold" Foreground="#1976d2"/>
                                        </GroupBox.Header>
                                        <local:ChartsProperties x:Name="Chart11" 
                    Title="Ute" YAxisTitle="V/A" XAxisTitle="Zaman"
                     LineColor="Red" BackgroundColor="White" MinY="0" MaxY="1000"/>
                                    </GroupBox>

                                    <!-- İstasyon 12 - Darıca Sahil -->
                                    <GroupBox Style="{StaticResource MiniChartGroupBox}">
                                        <GroupBox.Header>
                                            <TextBlock x:Name="Station12Header" Text="🚉 Darıca Sahil" FontWeight="Bold" Foreground="#1976d2"/>
                                        </GroupBox.Header>
                                        <local:ChartsProperties x:Name="Chart12" 
                    Title="Ute" YAxisTitle="V/A" XAxisTitle="Zaman"
                     LineColor="Red" BackgroundColor="White" MinY="0" MaxY="1000"/>
                                    </GroupBox>

                                </StackPanel>
                            </ScrollViewer>
                        </GroupBox>
                    </Grid>
                </TabItem>

                <!-- SEKME 2: 12 VLD-TFPR Detaylı Veriler (12 Alt Sekme) -->
                <TabItem Header="⚡ TFPR Cihaz Detayları">
                    <TabControl x:Name="DeviceTabControl" Margin="5">
                        <!-- Her istasyon için ayrı TabItem dinamik olarak kod tarafında oluşturulacak -->
                    </TabControl>
                </TabItem>

                <!-- SEKME 3: Hata Özeti (sağda) -->
                <TabItem Header="🧾 Hata Özeti">
                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBox x:Name="LogSearchTextBox" Width="220" Margin="0,0,6,0"
                                     ToolTip="İstasyon, kategori veya hata ara"
                                     TextChanged="LogFilterChanged"/>
                            <ComboBox x:Name="LogCategoryComboBox" Width="125" Margin="0,0,6,0"
                                      SelectedIndex="0" SelectionChanged="LogSelectionFilterChanged">
                                <ComboBoxItem Content="Tüm kategoriler"/>
                                <ComboBoxItem Content="KIRMIZI"/>
                                <ComboBoxItem Content="SARI"/>
                                <ComboBoxItem Content="NORMAL"/>
                            </ComboBox>
                            <ComboBox x:Name="LogStationComboBox" Width="180" Margin="0,0,6,0"
                                      SelectedIndex="0" SelectionChanged="LogSelectionFilterChanged">
                                <ComboBoxItem Content="Tüm istasyonlar"/>
                            </ComboBox>
                            <ComboBox x:Name="LogTimeRangeComboBox" Width="125" Margin="0,0,6,0"
                                      SelectedIndex="0" SelectionChanged="LogSelectionFilterChanged">
                                <ComboBoxItem Content="Tüm zamanlar"/>
                                <ComboBoxItem Content="Son 1 saat"/>
                                <ComboBoxItem Content="Son 24 saat"/>
                            </ComboBox>
                            <CheckBox x:Name="CriticalOnlyCheckBox" Content="Sadece kritik" VerticalAlignment="Center"
                                      Margin="4,0,12,0" Checked="LogFilterChanged" Unchecked="LogFilterChanged"/>
                            <Button Content="🗑 Logları Temizle" Click="ClearLogsButton_Click" Padding="10,4"/>
                        </WrapPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" MinWidth="420"/>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="*" MinWidth="300"/>
                            </Grid.ColumnDefinitions>

                            <ListBox x:Name="ErrorLogList" Grid.Column="0" BorderThickness="0"
                                     SelectionChanged="ErrorLogList_SelectionChanged"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{Binding CategoryBrush}" BorderThickness="4,0,0,0"
                                                Background="#FAFAFA" Padding="10,7" Margin="0,0,0,5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="86"/>
                                                    <ColumnDefinition Width="105"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat=HH:mm:ss}"
                                                           FontWeight="Bold" VerticalAlignment="Top"/>
                                                <TextBlock Grid.Column="1" Text="{Binding EffectiveCategory}"
                                                           Foreground="{Binding CategoryBrush}" FontWeight="Bold"/>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{Binding StationNames}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding CriticalDeviceCount, StringFormat={}{0} veri noktası}"
                                                               Foreground="#666666" FontSize="11"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="3" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding RepeatCount, StringFormat=Tekrar: {0}}" FontSize="11"/>
                                                    <TextBlock Text="DETAY" Foreground="#1976D2" FontWeight="Bold" FontSize="11"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Border Grid.Column="2" Background="#F7F9FA" BorderBrush="#D5DDE2" BorderThickness="1" Padding="14">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel DataContext="{Binding ElementName=ErrorLogList, Path=SelectedItem}">
                                        <TextBlock Text="Olay detayı" FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding StationNames}" Foreground="#555555" Margin="0,0,0,12"/>
                                        <TextBlock Text="Tren konumları" FontWeight="Bold" Margin="0,0,0,5"/>
                                        <ItemsControl ItemsSource="{Binding AllTrains}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{Binding CardBackground}" 
                                                            BorderBrush="{Binding CardBorderBrush}" 
                                                            BorderThickness="{Binding CardBorderThickness}" 
                                                            CornerRadius="6"
                                                            Padding="8,6" Margin="0,0,6,6" MinWidth="135">
                                                        <StackPanel>
                                                            <DockPanel LastChildFill="True">
                                                                <Border Background="{Binding BadgeBackground}" CornerRadius="3" Padding="4,1" Margin="4,0,0,0" DockPanel.Dock="Right"
                                                                        Visibility="{Binding BadgeVisibility}">
                                                                    <TextBlock Text="{Binding RepeatBadge}" Foreground="White" FontSize="9" FontWeight="Bold"/>
                                                                </Border>
                                                                <TextBlock Text="{Binding TrainId, StringFormat=Tren {0}}" FontWeight="Bold" FontSize="12"/>
                                                            </DockPanel>
                                                            <TextBlock Text="{Binding Position, StringFormat={}{0:N0} m}" Foreground="#1976D2" FontWeight="SemiBold" FontSize="11" Margin="0,2,0,0"/>
                                                            <TextBlock Text="{Binding TrackType}" Foreground="#666666" FontSize="10"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="Teknik özet" FontWeight="Bold" Margin="0,10,0,5"/>
                                        <TextBlock Text="{Binding LeakDisplay}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding MaxValuesDisplay}" Foreground="#555555" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding EN50122Summary}" Foreground="#555555" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

            </TabControl>

            <!-- Status Bar -->
            <StatusBar x:Name="StatusBar" Grid.Row="2">
                <StatusBarItem Content="🚆 VLD-TFPR Multi-Station - 12 Cihaz İzleme"/>
                <Separator/>
                <StatusBarItem x:Name="DataCountText" Content="TFPR Veri: 0"/>
                <Separator/>
                <StatusBarItem x:Name="LastUpdateText" Content="Son Güncelleme: --"/>
                <Separator/>
                <StatusBarItem Content="🟢 Hazır"/>

            </StatusBar>
        </Grid>

        <!-- Toast Notification (tek bildirim) -->
        <Border x:Name="ToastNotificationBorder"
                Background="#333333"
                CornerRadius="8"
                Padding="16,10"
                Margin="20"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Panel.ZIndex="999"
                Visibility="Collapsed">
            <TextBlock x:Name="ToastNotificationText"
                       Text=""
                       Foreground="White"
                       FontSize="13"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       MaxWidth="340"/>
        </Border>

        <!-- Toast Notification Stack (sağ alt köşe) -->
        <ItemsControl x:Name="ToastStackPanel"
                      Margin="20"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Bottom"
                      Panel.ZIndex="1000"
                      Width="360"/>
    </Grid>
</Window>